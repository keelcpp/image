@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(keel)
find_dependency(keel_compress)

include("${CMAKE_CURRENT_LIST_DIR}/keel_imageTargets.cmake")
if(NOT TARGET keel::image AND TARGET keel::keel_image)
    add_library(keel::image ALIAS keel::keel_image)
endif()
check_required_components(keel_image)
