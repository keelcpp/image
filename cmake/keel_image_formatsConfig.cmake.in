@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(keel)
find_dependency(keel_compress)

include("${CMAKE_CURRENT_LIST_DIR}/keel_image_formatsTargets.cmake")
if(NOT TARGET keel::image_formats AND TARGET keel::keel_image_formats)
    add_library(keel::image_formats ALIAS keel::keel_image_formats)
endif()
check_required_components(keel_image_formats)
